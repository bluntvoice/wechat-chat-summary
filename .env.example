# DeepSeek configuration.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
# as enabled/disabled
THINKING=false
# as high/max
THINKING_LEVEL=high
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Generic OpenAI Compatible configuration. Use with --provider openai-compatible.
# OPENAI_COMPATIBLE_API_KEY=your-provider-api-key
# OPENAI_COMPATIBLE_MODEL=your-model-name
# Base URL and full Chat Completions URL are both accepted.
# OPENAI_COMPATIBLE_API_URL=https://api.example.com/v1

# WeChatDataAnalysis 本地数据源。
WECHAT_DATA_API_URL=http://127.0.0.1:10392
# 多账号或多数据源时再填写；留空使用工具当前默认值。
# WECHAT_DATA_ACCOUNT=
# WECHAT_DATA_SOURCE=
# 检测到群成员昵称异常时，可按需启动本地上游修复分支复读。
# WECHAT_DATA_LOCAL_SOURCE_DIR=D:\path\to\WeChatDataAnalysis-source
# WECHAT_DATA_LOCAL_SOURCE_PORT=10393

# CLI 报告根目录必须由使用者显式填写；桌面端在界面中选择并单独保存。
# 不得选择源码、软件安装目录或 WeChatDataAnalysis 安装目录。
GROUP_INSIGHT_OUTPUT_ROOT=

# 异常告警邮箱配置（可选）。当 RPA 发送失败时，会尝试向以下地址发送告警邮件。
# 支持 QQ/163/企业微信邮箱等，密码通常填写 SMTP 授权码。
# ALERT_SMTP_HOST=smtp.qq.com
# ALERT_SMTP_PORT=465
# ALERT_SMTP_USER=your_email@qq.com
# ALERT_SMTP_PASSWORD=your_smtp_auth_code
# ALERT_FROM=your_email@qq.com
# ALERT_TO=receiver1@example.com,receiver2@example.com
